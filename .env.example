# =====================================================================
# Mink — landing page & dashboard environment variables
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored. NEVER put real secrets in `.env.example`.
# =====================================================================

# Public URL of this site (no trailing slash). Used for canonical URLs,
# OpenGraph, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------
# From: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only secret. Has full access to the database — bypasses RLS.
# Never prefix with NEXT_PUBLIC_. Only ever read in server code.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---------------------------------------------------------------------
# PostHog (product analytics — same project for web + iOS app)
# ---------------------------------------------------------------------
# From: https://app.posthog.com/project/settings (or eu.posthog.com).
# Use the EU endpoint if your project is hosted in the EU.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional — used by the dashboard "Analytics" page to deep-link into
# your PostHog project. Find the numeric project id in your PostHog URL.
NEXT_PUBLIC_POSTHOG_PROJECT_ID=
# Optional — public dashboard share link from PostHog (Insights →
# share → "Public link"). When set, the dashboard /analytics page
# embeds it.
NEXT_PUBLIC_POSTHOG_DASHBOARD_URL=
